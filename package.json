{
  "name": "vakilsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare-indexnow-key.mjs && node scripts/mavis/generate-offline-published-articles.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "validate:legal-library-seo": "node scripts/validate-legal-library-seo.mjs",
    "indexnow:prepare": "node scripts/prepare-indexnow-key.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "test:legal-library-http": "node scripts/verify-legal-library-http.mjs",
    "predev": "node scripts/mavis/generate-offline-published-articles.mjs",
    "validate:mavis-offline": "node scripts/mavis/validate-offline-bundle.mjs",
    "pretest:mavis-offline": "node scripts/mavis/generate-offline-published-articles.mjs",
    "test:mavis-offline": "node --test tests/mavis/offline-search.test.mjs tests/mavis/offline-answer.test.mjs tests/mavis/offline-shell.test.mjs",
    "test:mavis-search-console": "node --test tests/mavis/search-console-adapter.test.mjs tests/mavis/search-console-client.test.mjs tests/mavis/search-console-handler.test.mjs tests/mavis/growth-metrics.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4"
  }
}
