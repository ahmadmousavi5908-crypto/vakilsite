# Public canonical site origin, e.g. https://your-domain.ir
NEXT_PUBLIC_SITE_URL=

# Search Console / Bing Webmaster Tools verification values
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, numbers, or hyphens)
# Generate one and keep it in .env.local; do not commit the real value.
INDEXNOW_KEY=

# Supabase project settings (never commit real secret keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional read-only Google Search Console connection. Keep all OAuth values server-side.
# The connected Google account must have access to the verified Search Console property.
MAVIS_GSC_CLIENT_ID=
MAVIS_GSC_CLIENT_SECRET=
MAVIS_GSC_REFRESH_TOKEN=
MAVIS_GSC_SITE_URL=
MAVIS_GSC_TIMEOUT_MS=20000

# WhatsApp number in international digits only, without + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=989169165902

# Optional public business email, added after confirmation
NEXT_PUBLIC_CONTACT_EMAIL=
