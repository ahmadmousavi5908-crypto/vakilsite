# Public canonical site origin, e.g. https://your-domain.ir
NEXT_PUBLIC_SITE_URL=

# Search Console / Bing Webmaster Tools verification values
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, numbers, or hyphens)
# Generate one and keep it in .env.local; do not commit the real value.
INDEXNOW_KEY=

# Supabase project settings (never commit real secret keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Never add NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=

# Server-only HMAC key for MAVIS intake idempotency (minimum 32 characters).
# Generate locally with: openssl rand -hex 32. Never commit a real value.
MAVIS_INTAKE_IDEMPOTENCY_SECRET=

# Server-only HMAC key for anonymous intake rate-limit identifiers (minimum 32 characters).
MAVIS_INTAKE_RATE_LIMIT_SECRET=

# Required only after the owner/legal-approved retention policy is configured (1-3650 days).
MAVIS_INTAKE_RETENTION_DAYS=

# Intake is deliberately disabled until the isolated database and operational gates are approved.
MAVIS_INTAKE_ENABLED=false
MAVIS_INTAKE_SCHEMA_READY=false

# Enable only when the trusted reverse proxy overwrites X-Real-IP and the deployment is verified.
MAVIS_TRUST_X_REAL_IP=false

# Public MAVIS chat remains disabled until legal, provider, rate-limit and release gates are approved.
MAVIS_PUBLIC_ENABLED=false
MAVIS_PROVIDER=mock
# Required only when MAVIS_PROVIDER=openai; keep this server-side and never expose it to the browser.
OPENAI_API_KEY=
MAVIS_OPENAI_MODEL=
MAVIS_OPENAI_TIMEOUT_MS=30000
MAVIS_MAX_OUTPUT_TOKENS=700

# WhatsApp number in international digits only, without + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=989169165902

# Optional public business email, added after confirmation
NEXT_PUBLIC_CONTACT_EMAIL=
